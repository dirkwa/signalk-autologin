{
  "name": "signalk-autologin",
  "version": "0.1.0",
  "description": "Convenience autologin for Signal K: treat every device as an admin without a login. The modern replacement for security-off. Trusted networks only.",
  "main": "plugin/index.js",
  "type": "module",
  "signalk-plugin-enabled-by-default": true,
  "scripts": {
    "format": "prettier --write \"src/**/*.{ts,tsx}\" && eslint --fix \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "build:plugin": "tsc",
    "build:config": "vite build",
    "build": "npm run build:plugin && npm run build:config",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-plugin-configurator",
    "signalk-category-utility"
  ],
  "signalk": {
    "displayName": "Autologin (admin)",
    "appIcon": "./app-icon.svg"
  },
  "files": [
    "plugin/**/*",
    "public/**/*",
    "app-icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "signalk": ">=2.27.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@module-federation/vite": "^1.15.0",
    "@signalk/server-api": "^2.24.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "express": "^5.2.1",
    "prettier": "^3.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.11",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0"
}
